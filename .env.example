# Your merchant's public Solana address. Never put a private key or seed phrase here.
RECIPIENT_WALLET=REPLACE_WITH_YOUR_MERCHANT_PUBLIC_KEY

# Production defaults to mainnet. Use a dedicated RPC provider in production; public RPC is rate-limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta

# Public URL of this app, no trailing slash. Used in Actions metadata and demo links.
PUBLIC_URL=http://localhost:3000

# Optional app branding
APP_NAME=Solana Merchant Desk
APP_DESCRIPTION=Create Solana payment links with invoice references and verify finalized payments.
DEFAULT_AMOUNT_SOL=0.01
MAX_AMOUNT_SOL=10
PORT=3000
TRUST_PROXY=false
DEMO_MODE=false
